{
  "name": "@maelitop/mention-mcp-server",
  "version": "1.4.1",
  "type": "module",
  "bin": {
    "mention-mcp-server": "dist/index.js"
  },
  "files": ["dist/**/*", "CHANGELOG.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "ci": "npm run check && npm run build && npm run test:run",
    "version": "biome format --write package.json"
  },
  "keywords": ["mcp", "mention", "monitoring", "api", "agorapulse"],
  "author": "MaelitoP",
  "license": "MIT",
  "description": "MCP server for the Mention API to monitor web and social media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaelitoP/mention-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/MaelitoP/mention-mcp-server/issues"
  },
  "homepage": "https://github.com/MaelitoP/mention-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.56",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
